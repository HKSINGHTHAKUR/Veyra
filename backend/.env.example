# ── Database ────────────────────────────────────────────────────────────────
DB_URL=jdbc:postgresql://localhost:5432/healthcare_appointments
DB_USERNAME=postgres
DB_PASSWORD=your_password_here

# ── JWT ─────────────────────────────────────────────────────────────────────
# Must be a random, secret string of at least 32 characters.
JWT_SECRET=replace-with-a-random-secret-key-at-least-32-chars
JWT_EXPIRATION_MS=86400000

# ── Email provider ────────────────────────────────────────────────────────────
# resend (default, HTTPS API) | smtp (legacy, local development)
MAIL_PROVIDER=resend

# ── Email (Resend HTTPS API — primary transport) ──────────────────────────────
# Create an API key at https://resend.com and verify your sender domain/email.
RESEND_API_KEY=re_xxxxxxxxxxxx
RESEND_FROM_EMAIL=your-verified-sender@domain.com
RESEND_FROM_NAME=Veyra

# ── Email (SMTP — legacy, only used when MAIL_PROVIDER=smtp) ──────────────────
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
# Use an App Password when 2FA is enabled on your Google account.
MAIL_PASSWORD=your-app-password

# ── OpenAI ──────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_SECONDS=30

# ── Google Calendar (OAuth 2.0) ──────────────────────────────────────────────
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
# Must match the authorized redirect URI in Google Cloud Console
GOOGLE_REDIRECT_URI=http://localhost:8080/api/calendar/callback
GOOGLE_CALENDAR_MAX_RETRIES=3
GOOGLE_CALENDAR_BATCH_SIZE=20
GOOGLE_CALENDAR_WORKER_INTERVAL_MS=60000

# ── Notifications ────────────────────────────────────────────────────────────
NOTIFICATION_MAX_RETRIES=3
NOTIFICATION_BATCH_SIZE=20
NOTIFICATION_WORKER_INTERVAL_MS=30000
NOTIFICATION_REMINDER_INTERVAL_MS=60000
NOTIFICATION_REMINDER_WINDOW_MINUTES=60

# ── Application ──────────────────────────────────────────────────────────────
# SAFE DEFAULT false: set true ONLY in local dev to create admin@/doctor@/patient@healthcare.dev
APP_SEED_ENABLED=false
SLOT_HOLD_DURATION_MINUTES=10
FRONTEND_URL=http://localhost:5173
PORT=8080
